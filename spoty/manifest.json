{
  "manifest_version": 3,
  "name": "Spotify Ad Skipper Pro",
  "version": "1.0.0",
  "description": "Instantly mutes and skips ads on Spotify Web Player without you noticing.",
  "permissions": ["storage"],
  "host_permissions": ["https://open.spotify.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Spotify Ad Skipper Pro"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
